# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
# Tie the app to a US sandbox business account and turn on "Save payment methods".
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Claude API key (console.anthropic.com). Used to read the caregiver's rules.
ANTHROPIC_API_KEY=

# Local SQLite file. Created on first run.
DATABASE_URL=file:./data/guardian.db
